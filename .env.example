# ===========================
# Kichobot Unified Server
# ===========================

# Server port (Render sets this automatically)
PORT=5000

# MongoDB connection string
DB_URI=mongodb://localhost:27017/kichobot

# JWT Secrets
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret

# University Portal (KSU)
KSU_DOMAIN=https://schedule.buketov.edu.kz
KSU_LOGIN=your_ksu_login
KSU_PASSWORD=your_ksu_password

# Telegram Bot
TG_TOKEN=your_bot_token
LOG_CHANEL_ID=-100xxxxxxxxxx
LOGGER_TG_TOKEN=your_logger_bot_token
BOT_ID=123456789

# Bot mode: polling or webhook
BOT_MODE=polling
# WEBHOOK_DOMAIN=https://your-render-service.onrender.com
# WEBHOOK_PATH=/bot/webhook

# Debug
DEBUG=true

# Browser/Proxy
START_BROWSER=true
AUTO_KSU_AUTH=true
USE_PROXY=false
USE_FREE_PROXIES=false
# HTTP_PROXY=http://proxy.example.com:8080
# PROXY_LOGIN=username
# PROXY_PASSWORD=password

# Official Schedule API
SCHEDULE_API_URL=https://schedule.karnu-buketov.edu.kz/api/v1/schedule
SCHEDULE_API_KEY=your_schedule_api_key_here
